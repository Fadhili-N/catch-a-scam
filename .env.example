# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# Supabase dashboard -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key. Safe to expose to the browser: it only grants the access
# our Row Level Security policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses ALL Row Level Security. Server-side only.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# The Python image-matching service (services/image-matching) and the
# password shared with it. Must match that service's own .env exactly.
IMAGE_MATCHING_SERVICE_URL=http://localhost:8001
IMAGE_MATCHING_SERVICE_SECRET=
