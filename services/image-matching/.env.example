# Copy this file to .env and fill in the real values. .env is git-ignored.

# Same Supabase project as the Next.js app's catch-a-scam/.env.local.
SUPABASE_URL=
# The "secret" / service-role key — Project Settings -> API Keys. This
# service needs it to bypass RLS (writing perceptual_hash and
# photo_matches rows is not something any ordinary RLS policy allows).
SUPABASE_SERVICE_ROLE_KEY=

# A password only the Next.js app and this service know, so a stranger who
# finds this service's URL can't trigger it. Make up any long random
# string and put the SAME value in catch-a-scam/.env.local as
# IMAGE_MATCHING_SERVICE_SECRET.
INTERNAL_SECRET=

# Hamming distance (out of 64 bits) below which two images count as a
# match. 10 is a conservative default — see app/config.py for the reasoning.
MATCH_THRESHOLD=10
